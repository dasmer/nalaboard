{
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.nalaboard.com" }],
      "headers": { "Location": "https://nalaboard.com/$1" },
      "status": 308
    },
    {
      "src": "/(.*)",
      "dest": "__COMPUTE_ORIGIN__/$1",
      "transforms": [{
        "type": "request.headers",
        "op": "set",
        "target": { "key": "x-origin-secret" },
        "args": "$ORIGIN_SECRET",
        "env": ["ORIGIN_SECRET"]
      }]
    }
  ]
}
